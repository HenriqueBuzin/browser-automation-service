APP_ROLE=worker
WORKER_ADAPTER=appium
ADAPTER_PLATFORM=ios
ADAPTER_INSTANCE_ALIAS=browser-adapter-appium-ios
APPIUM_REMOTE_URL=http://127.0.0.1:4723
WORKER_CONCURRENCY=1
WORKER_CAPACITY_UNITS=2

POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=browser_automation_v2
POSTGRES_USER=browser_automation
POSTGRES_PASSWORD_FILE=/opt/browser-automation-service/secrets/postgres_password

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=browser_automation
REDIS_PASSWORD_FILE=/opt/browser-automation-service/secrets/redis_password

ARTIFACT_BACKEND=s3
S3_BUCKET=browser-artifacts
S3_REGION=sa-east-1
AWS_ACCESS_KEY_ID_FILE=/opt/browser-automation-service/secrets/aws_access_key_id
AWS_SECRET_ACCESS_KEY_FILE=/opt/browser-automation-service/secrets/aws_secret_access_key
