<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.henriquebuzin.browser-adapter-appium-ios</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/browser-automation-service/deploy/macos/run-appium-ios-worker.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/browser-automation-service</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/browser-adapter-appium-ios.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/browser-adapter-appium-ios.error.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
</plist>
