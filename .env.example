# Generate with: openssl rand -hex 32
API_KEY=replace-with-at-least-32-random-characters

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
MAX_CONCURRENT_BROWSERS=2
MAX_QUEUE_SIZE=20
MAX_QUEUE_WAIT_MS=120000
LEASE_CONNECT_TIMEOUT_MS=30000
MAX_LEASE_DURATION_MS=900000
SHUTDOWN_TIMEOUT_MS=30000

# URL visible to consumer containers. Do not publish it on the internet.
PUBLIC_WS_URL=ws://browser-automation-service:3000

# Optional. Enables the Selenium provider when its Docker Compose profile is active.
SELENIUM_REMOTE_URL=

# Optional separate key protecting /metrics. If empty, API_KEY is used.
METRICS_API_KEY=
