API_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=30000
DISPATCHER_INTERVAL_MS=500
MAX_ACTIVE_JOBS_PER_CLIENT=10
ARTIFACT_RETENTION_HOURS=168

PLAYWRIGHT_CONCURRENCY=2
PLAYWRIGHT_CAPACITY_UNITS=3
PUPPETEER_CONCURRENCY=2
PUPPETEER_CAPACITY_UNITS=2
SELENIUM_CONCURRENCY=3
SELENIUM_CAPACITY_UNITS=3

# Optional OTLP HTTP collector base URL.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Comma-separated exact hosts or wildcard suffixes (for example: app,*.internal.example).
ALLOWED_HOSTS=
