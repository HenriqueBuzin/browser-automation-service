COMPOSE_PROJECT_NAME=browser-automation-service

# Sensitive values. Docker Compose converts these variables into files mounted
# at /run/secrets; they are not forwarded to the container environment.
API_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://browser_automation:replace-with-a-strong-password@postgres:5432/browser_automation
REDIS_PASSWORD=replace-with-a-strong-redis-password

PORT=3000
PUBLIC_BASE_URL=https://browser-automation.example.com
PROXY_NETWORK=proxy-network
POSTGRES_NETWORK=postgres-network
BROWSER_AUTOMATION_NETWORK=browser-automation-network
LOG_LEVEL=info
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=30000
DISPATCHER_INTERVAL_MS=500
MAX_ACTIVE_JOBS_PER_CLIENT=10
ARTIFACT_RETENTION_HOURS=168
ARTIFACT_BACKEND=local
S3_BUCKET=browser-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Required only when compose.s3.yaml is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PLAYWRIGHT_CONCURRENCY=2
PLAYWRIGHT_CAPACITY_UNITS=3
PUPPETEER_CONCURRENCY=2
PUPPETEER_CAPACITY_UNITS=2
SELENIUM_CONCURRENCY=3
SELENIUM_CAPACITY_UNITS=3

# Leave empty for the default five-combination Playwright/Puppeteer matrix.
# Set both values below when starting the selenium-all profile.
BROWSER_SELENIUM_REMOTE_URL=
SELENIUM_BROWSERS=chromium

# Optional OTLP HTTP collector base URL.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Comma-separated exact hosts or wildcard suffixes (for example: app,*.internal.example).
ALLOWED_HOSTS=
