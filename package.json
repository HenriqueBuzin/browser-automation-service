{
  "name": "browser-automation-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Durable asynchronous cross-browser automation platform.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@fastify/static": "10.1.2"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sinclair/typebox": "0.34.52",
    "bullmq": "5.81.2",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "playwright": "1.62.0",
    "puppeteer-core": "25.3.0",
    "selenium-webdriver": "4.46.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/selenium-webdriver": "4.35.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.5": true
  }
}
